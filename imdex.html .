```html
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Jeu 2D</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #111827;
            color: white;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        h1 {
            margin: 15px 0 5px;
        }

        #score {
            font-size: 22px;
            margin-bottom: 10px;
        }

        canvas {
            background: #22c55e;
            border: 4px solid white;
            max-width: 95%;
            height: auto;
        }

        button {
            margin-top: 15px;
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            background: #2563eb;
            color: white;
            font-size: 18px;
            cursor: pointer;
        }

        button:hover {
            background: #1d4ed8;
        }
    </style>
</head>

<body>

    <h1>🎮 Attrape les pièces</h1>

    <div id="score">
        Score : <span id="scoreValue">0</span>
    </div>

    <canvas id="game" width="800" height="500"></canvas>

    <br>

    <button onclick="restartGame()">🔄 Recommencer</button>

    <script>

        const canvas = document.getElementById("game");
        const ctx = canvas.getContext("2d");

        const scoreElement = document.getElementById("scoreValue");

        let score = 0;
        let gameOver = false;

        const player = {
            x: 380,
            y: 420,
            width: 40,
            height: 40,
            speed: 6
        };

        const coin = {
            x: 300,
            y: 100,
            radius: 12
        };

        const enemy = {
            x: 100,
            y: 100,
            width: 40,
            height: 40,
            speed: 3
        };

        const keys = {};

        document.addEventListener("keydown", function(event) {
            keys[event.key] = true;
        });

        document.addEventListener("keyup", function(event) {
            keys[event.key] = false;
        });

        function movePlayer() {

            if (keys["ArrowLeft"] || keys["q"]) {
                player.x -= player.speed;
            }

            if (keys["ArrowRight"] || keys["d"]) {
                player.x += player.speed;
            }

            if (keys["ArrowUp"] || keys["z"]) {
                player.y -= player.speed;
            }

            if (keys["ArrowDown"] || keys["s"]) {
                player.y += player.speed;
            }

            // Empêcher le joueur de sortir de l'écran
            if (player.x < 0)
                player.x = 0;

            if (player.y < 0)
                player.y = 0;

            if (player.x + player.width > canvas.width)
                player.x = canvas.width - player.width;

            if (player.y + player.height > canvas.height)
                player.y = canvas.height - player.height;
        }

        function moveEnemy() {

            if (enemy.x < player.x)
                enemy.x += enemy.speed;

            if (enemy.x > player.x)
                enemy.x -= enemy.speed;

            if (enemy.y < player.y)
                enemy.y += enemy.speed;

            if (enemy.y > player.y)
                enemy.y -= enemy.speed;
        }

        function randomCoin() {

            coin.x = Math.random() * (canvas.width - 30) + 15;
            coin.y = Math.random() * (canvas.height - 30) + 15;
        }

        function collision(a, b) {

            return (
                a.x < b.x + b.width &&
                a.x + a.width > b.x &&
                a.y < b.y + b.height &&
                a.y + a.height > b.y
            );
        }

        function collectCoin() {

            const dx = player.x + player.width / 2 - coin.x;
            const dy = player.y + player.height / 2 - coin.y;

            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < 30) {

                score++;

                scoreElement.textContent = score;

                randomCoin();

                // L'ennemi devient plus rapide
                enemy.speed += 0.2;
            }
        }

        function checkEnemyCollision() {

            if (collision(player, enemy)) {

                gameOver = true;

                setTimeout(() => {
                    alert("💀 Game Over ! Score : " + score);
                }, 100);
            }
        }

        function drawPlayer() {

            ctx.fillStyle = "#2563eb";

            ctx.fillRect(
                player.x,
                player.y,
                player.width,
                player.height
            );
        }

        function drawCoin() {

            ctx.beginPath();

            ctx.arc(
                coin.x,
                coin.y,
                coin.radius,
                0,
                Math.PI * 2
            );

            ctx.fillStyle = "#facc15";

            ctx.fill();

            ctx.closePath();
        }

        function drawEnemy() {

            ctx.fillStyle = "#dc2626";

            ctx.fillRect(
                enemy.x,
                enemy.y,
                enemy.width,
                enemy.height
            );
        }

        function drawBackground() {

            ctx.fillStyle = "#22c55e";

            ctx.fillRect(
                0,
                0,
                canvas.width,
                canvas.height
            );

            // petites décorations
            ctx.fillStyle = "#16a34a";

            for (let i = 0; i < 30; i++) {

                const x = (i * 137) % canvas.width;
                const y = (i * 83) % canvas.height;

                ctx.fillRect(x, y, 5, 5);
            }
        }

        function gameLoop() {

            if (gameOver)
                return;

            drawBackground();

            movePlayer();

            moveEnemy();

            collectCoin();

            checkEnemyCollision();

            drawCoin();

            drawEnemy();

            drawPlayer();

            requestAnimationFrame(gameLoop);
        }

        function restartGame() {

            score = 0;

            scoreElement.textContent = score;

            gameOver = false;

            player.x = 380;
            player.y = 420;

            enemy.x = 100;
            enemy.y = 100;

            enemy.speed = 3;

            randomCoin();

            gameLoop();
        }

        randomCoin();

        gameLoop();

    </script>

</body>
</html>
